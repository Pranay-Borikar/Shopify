<div class="brand-story-page">
  <section class="brand-story-hero">
    <div class="brand-story-hero__copy"><p class="brand-eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p></div>
    <div class="brand-story-hero__image">{% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}</div>
  </section>
  <section class="brand-story-intro"><p class="brand-eyebrow">{{ section.settings.intro_eyebrow }}</p><h2>{{ section.settings.intro_heading }}</h2><div>{{ section.settings.intro_text }}</div></section>
  <section class="brand-story-feature"><div class="brand-story-feature__image">{% if section.settings.feature_image %}{{ section.settings.feature_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div><div class="brand-story-feature__copy"><p class="brand-eyebrow">{{ section.settings.feature_eyebrow }}</p><h2>{{ section.settings.feature_heading }}</h2><p>{{ section.settings.feature_text }}</p></div></section>
</div>
{% stylesheet %}
  .brand-story-page { background: #fefefd; color: #333a30; }
  .brand-eyebrow { margin: 0 0 18px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; }
  .brand-story-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 520px; background: #eeecea; }
  .brand-story-hero__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(32px, 8vw, 110px); }
  .brand-story-hero h1 { max-width: 560px; margin: 0; font-size: clamp(2.8rem, 5vw, 5.5rem); line-height: .94; letter-spacing: -.07em; text-transform: uppercase; }
  .brand-story-hero__copy > p:last-child { max-width: 430px; margin-top: 28px; color: #60645a; line-height: 1.6; }
  .brand-story-hero__image, .brand-story-feature__image { min-height: 420px; overflow: hidden; background: #ededdb; }
  .brand-story-hero__image img, .brand-story-feature__image img, .brand-story-hero__image svg, .brand-story-feature__image svg { width: 100%; height: 100%; object-fit: cover; }
  .brand-story-intro { max-width: 680px; margin: 0 auto; padding: 80px 24px; text-align: center; }
  .brand-story-intro h2, .brand-story-feature h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; letter-spacing: -.05em; }
  .brand-story-intro > div { margin-top: 24px; color: #60645a; line-height: 1.7; }
  .brand-story-feature { display: grid; grid-template-columns: 1fr 1fr; max-width: 1180px; min-height: 470px; margin: 0 auto 100px; background: #ededdb; }
  .brand-story-feature__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(30px, 7vw, 90px); }
  .brand-story-feature__copy > p:last-child { max-width: 420px; margin-top: 24px; color: #60645a; line-height: 1.7; }
  @media (max-width: 720px) { .brand-story-hero, .brand-story-feature { grid-template-columns: 1fr; } .brand-story-hero__image { min-height: 360px; } .brand-story-feature { margin-inline: 16px; } }
{% endstylesheet %}
{% schema %}
{ "name": "Brand story", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Hero eyebrow", "default": "Our story" },
  { "type": "text", "id": "heading", "label": "Hero heading", "default": "Embrace your femininity" },
  { "type": "textarea", "id": "intro", "label": "Hero intro", "default": "Designed to embrace your femininity and unleash your inner goddess." },
  { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
  { "type": "text", "id": "intro_eyebrow", "label": "Intro eyebrow", "default": "Who we are + what we stand for" },
  { "type": "text", "id": "intro_heading", "label": "Intro heading", "default": "Clothing with a little more feeling." },
  { "type": "richtext", "id": "intro_text", "label": "Intro text", "default": "<p>We create timeless pieces for the everyday moments worth remembering. Thoughtful details, beautiful fabrics, and a point of view that feels entirely your own.</p>" },
  { "type": "image_picker", "id": "feature_image", "label": "Feature image" },
  { "type": "text", "id": "feature_eyebrow", "label": "Feature eyebrow", "default": "Founder" },
  { "type": "text", "id": "feature_heading", "label": "Feature heading", "default": "Made for your becoming." },
  { "type": "textarea", "id": "feature_text", "label": "Feature text", "default": "Every piece is designed to help you feel comfortable, confident, and completely yourself." }
] }
{% endschema %}
