<section class="vintage-collection vintage-collection-width">
  <div class="vintage-collection__intro"><p class="collection-eyebrow">Shop the edit</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div>
  <div class="vintage-collection__tools"><span>{{ collection.products_count }} pieces</span><button type="button" onclick="document.querySelector('.collection-filters').classList.toggle('is-open')">Filter & sort</button></div>
  <div class="collection-filters"><form><label>Sort by<select name="sort_by" onchange="this.form.submit()">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label></form></div>
  {% paginate collection.products by 16 %}<div class="vintage-collection__grid">{% for product in collection.products %}<a class="vintage-card" href="{{ product.url }}"><div class="vintage-card__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}{% else %}<img src="{{ 'product.jpeg' | asset_url }}" width="800" height="1067" alt="{{ product.title | escape }}" loading="lazy">{% endif %}{% if product.compare_at_price > product.price %}<span>Sale</span>{% endif %}</div><div class="vintage-card__info"><span>{{ product.title }}</span><span>{{ product.price | money }}</span></div></a>{% endfor %}</div><div class="vintage-pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}
</section>
{% stylesheet %}
  .vintage-collection-width { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }.vintage-collection { padding: 70px 0 100px; }
  .collection-eyebrow { margin: 0 0 18px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; }
  .vintage-collection__intro { max-width: 720px; margin-bottom: 60px; }.vintage-collection h1 { margin: 0; font-size: clamp(3rem, 7vw, 6rem); line-height: .9; letter-spacing: -.07em; }.vintage-collection__intro > div { max-width: 500px; margin-top: 24px; color: #60645a; line-height: 1.6; }
  .vintage-collection__tools { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-top: 1px solid #dfe0c7; border-bottom: 1px solid #dfe0c7; color: #60645a; font-size: 12px; }.vintage-collection__tools button { padding: 10px 18px; border: 1px solid #a8a854; border-radius: 40px; background: transparent; color: #333a30; cursor: pointer; }
  .collection-filters { display: none; padding: 18px 0; }.collection-filters.is-open { display: block; }.collection-filters select { margin-left: 12px; padding: 8px 12px; border: 1px solid #bfc19d; border-radius: 40px; }
  .vintage-collection__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px 16px; padding-top: 28px; }.vintage-card { color: inherit; text-decoration: none; }.vintage-card__image { position: relative; overflow: hidden; aspect-ratio: 3 / 4; border-radius: 10px; background: #ededdb; }.vintage-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }.vintage-card:hover img { transform: scale(1.04); }.vintage-card__image span { position: absolute; top: 12px; left: 12px; padding: 6px 12px; border-radius: 40px; background: white; font-size: 10px; text-transform: uppercase; }.vintage-card__info { display: flex; justify-content: space-between; gap: 10px; padding-top: 12px; font-size: 13px; }.vintage-card__info span:last-child { color: #777b70; }.vintage-pagination { padding-top: 40px; text-align: center; }.vintage-pagination a, .vintage-pagination span { margin: 0 5px; color: inherit; text-decoration: none; }
  @media (max-width: 800px) { .vintage-collection__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .vintage-collection-width { width: calc(100% - 32px); }.vintage-collection { padding-top: 45px; }.vintage-collection__grid { gap: 28px 10px; } }
{% endstylesheet %}
{% schema %}{ "name": "Vintage collection", "settings": [] }{% endschema %}
