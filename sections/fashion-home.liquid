<div class="fashion-home full-width">
  <section class="fashion-hero">
    <div class="fashion-hero__carousel" aria-label="Featured collection carousel">
      {% assign default_slide_image = 'header.webp' | asset_url %}
      <div class="fashion-hero__slide" style="--slide: 0">{% if section.settings.slide_1_image != blank %}{{ section.settings.slide_1_image | image_url: width: 2400 | image_tag: class: 'fashion-hero__image', loading: 'eager' }}{% else %}<img class="fashion-hero__image" src="{{ default_slide_image }}" width="1600" height="900" alt="MarkAvenue collection" loading="eager">{% endif %}</div>
      <div class="fashion-hero__slide" style="--slide: 1">{% if section.settings.slide_2_image != blank %}{{ section.settings.slide_2_image | image_url: width: 2400 | image_tag: class: 'fashion-hero__image', loading: 'lazy' }}{% else %}<img class="fashion-hero__image" src="{{ default_slide_image }}" width="1600" height="900" alt="MarkAvenue collection" loading="lazy">{% endif %}</div>
      <div class="fashion-hero__slide" style="--slide: 2">{% if section.settings.slide_3_image != blank %}{{ section.settings.slide_3_image | image_url: width: 2400 | image_tag: class: 'fashion-hero__image', loading: 'lazy' }}{% else %}<img class="fashion-hero__image" src="{{ default_slide_image }}" width="1600" height="900" alt="MarkAvenue collection" loading="lazy">{% endif %}</div>
      <div class="fashion-hero__slide" style="--slide: 3">{% if section.settings.slide_4_image != blank %}{{ section.settings.slide_4_image | image_url: width: 2400 | image_tag: class: 'fashion-hero__image', loading: 'lazy' }}{% else %}<img class="fashion-hero__image" src="{{ default_slide_image }}" width="1600" height="900" alt="MarkAvenue collection" loading="lazy">{% endif %}</div>
    </div>
    <div class="fashion-hero__content">
      <p class="fashion-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="fashion-hero__text">{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}
        <a class="fashion-button fashion-button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} <span aria-hidden="true">↗</span></a>
      {% endif %}
    </div>
  </section>

  <div class="fashion-ticker" aria-label="Store benefits">
    <span>FREE SHIPPING OVER {{ section.settings.free_shipping_threshold }}</span><span>CONSCIOUSLY MADE</span><span>DESIGNED FOR EVERYDAY</span><span>FREE SHIPPING OVER {{ section.settings.free_shipping_threshold }}</span>
  </div>

  <section class="fashion-latest-products page-width">
    <div class="fashion-section-heading"><div><p class="fashion-eyebrow">New arrivals</p><h2>Pieces with presence.</h2></div><a class="fashion-text-link" href="{{ routes.all_products_collection_url }}">Shop all <span aria-hidden="true">↗</span></a></div>
    {% if collections.all.products_count > 0 %}
      <div class="fashion-product-grid">{% for product in collections.all.products limit: 10 %}<a class="fashion-product-card" href="{{ product.url }}"><div class="fashion-product-card__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 20vw, 50vw' }}{% else %}<img src="{{ 'product.jpeg' | asset_url }}" width="900" height="1200" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</div><div class="fashion-product-card__info"><span>{{ product.title }}</span><span>{{ product.price | money }}</span></div></a>{% endfor %}</div>
    {% else %}
      <div class="fashion-product-grid">{% for index in (1..10) %}<a class="fashion-product-card" href="{{ routes.all_products_collection_url }}"><div class="fashion-product-card__image"><img src="{{ 'product.jpeg' | asset_url }}" width="900" height="1200" alt="MarkAvenue sample product {{ index }}" loading="lazy"></div><div class="fashion-product-card__info"><span>MarkAvenue Edit {{ index }}</span><span>₹1,999</span></div></a>{% endfor %}</div>
    {% endif %}
  </section>

  <section class="fashion-collections page-width">
    {% render 'collection-card', collection: section.settings.collection_1 %}
    {% render 'collection-card', collection: section.settings.collection_2 %}
    {% render 'collection-card', collection: section.settings.collection_3 %}
  </section>

  {% assign featured_collection = section.settings.collection %}
  <section class="fashion-products page-width">
    <div class="fashion-section-heading">
      <div><p class="fashion-eyebrow">{{ section.settings.collection_eyebrow }}</p><h2>{{ section.settings.collection_heading }}</h2></div>
      {% if featured_collection != blank %}<a class="fashion-text-link" href="{{ featured_collection.url }}">Shop all <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="fashion-product-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <a class="fashion-product-card" href="{{ product.url }}">
            <div class="fashion-product-card__image">
              {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw' }}{% else %}<img src="{{ 'product.jpeg' | asset_url }}" width="900" height="1200" alt="{{ product.title | escape }}" loading="lazy">{% endif %}
              {% if product.compare_at_price > product.price %}<span class="fashion-badge">Sale</span>{% endif %}
            </div>
            <div class="fashion-product-card__info"><span>{{ product.title }}</span><span>{{ product.price | money }}</span></div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="fashion-empty-state"><p>Select a collection in the Theme Editor to show your latest pieces here.</p><a class="fashion-button" href="{{ routes.all_products_collection_url }}">Browse the store</a></div>
    {% endif %}
  </section>

  <section class="fashion-story page-width">
    <div class="fashion-story__panel"><p class="fashion-eyebrow">{{ section.settings.story_eyebrow }}</p><h2>{{ section.settings.story_heading }}</h2><p>{{ section.settings.story_text }}</p><a class="fashion-text-link" href="{{ section.settings.story_link | default: routes.root_url }}">Our approach <span aria-hidden="true">↗</span></a></div>
    <div class="fashion-story__shape" aria-hidden="true"><span></span></div>
  </section>
</div>

{% stylesheet %}
  .fashion-home { width: 100%; overflow: hidden; background: #fefefd; color: #333a30; }
  .fashion-announcement { display: flex; justify-content: center; gap: 18px; padding: 11px 20px; background: #ededdb; color: #333a30; font-size: 11px; letter-spacing: .13em; text-align: center; text-transform: uppercase; }
  .fashion-announcement span { color: #a8a854; }
  .page-width { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
  .fashion-hero { min-height: min(720px, 82vh); position: relative; display: grid; align-items: end; isolation: isolate; background: radial-gradient(circle at 78% 18%, #cbcb97, transparent 28%), linear-gradient(115deg, #ededdb 0%, #eeecea 52%, #a8a854 100%); }
  .fashion-hero::before { content: ''; position: absolute; inset: 0; z-index: -2; opacity: .3; background: repeating-linear-gradient(115deg, transparent 0 12px, rgba(255,255,255,.22) 13px 14px); }
  .fashion-hero__carousel, .fashion-hero__slide { position: absolute; inset: 0; z-index: -1; }
  .fashion-hero__slide { opacity: 0; animation: markavenue-slide 20s infinite; animation-delay: calc(var(--slide) * 5s); }
  .fashion-hero__slide:first-child { opacity: 1; }
  @keyframes markavenue-slide { 0%, 23% { opacity: 1; } 25%, 100% { opacity: 0; } }
  .fashion-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; mix-blend-mode: multiply; opacity: .84; }
  .fashion-hero__wash { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(23,26,21,.62), rgba(23,26,21,.04) 75%), linear-gradient(0deg, rgba(23,26,21,.42), transparent 45%); }
  .fashion-hero__content { display: none; }
  .fashion-eyebrow { margin: 0 0 18px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; }
  .fashion-hero h1 { max-width: 680px; margin: 0; font-size: clamp(3.4rem, 8vw, 7.6rem); line-height: .9; letter-spacing: -.07em; font-weight: 500; }
  .fashion-hero__text { max-width: 390px; margin: 28px 0 30px; font-size: 16px; line-height: 1.5; }
  .fashion-button { display: inline-flex; align-items: center; gap: 20px; padding: 15px 22px; border: 2px solid #333a30; border-radius: 40px; background: #333a30; color: #fff; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; transition: transform .2s ease, background .2s ease; }
  .fashion-button:hover { transform: translateY(-2px); background: #a8a854; border-color: #a8a854; }
  .fashion-button--light { background: #fff; color: #333a30; border-color: #fff; }
  .fashion-hero__stamp { position: absolute; right: 8%; top: 20%; display: grid; place-items: center; width: 112px; height: 112px; border: 1px solid rgba(255,255,255,.7); border-radius: 50%; color: #fffdf8; font-size: 10px; line-height: 1.4; letter-spacing: .16em; text-align: center; transform: rotate(12deg); }
  .fashion-ticker { display: flex; gap: 55px; justify-content: center; padding: 16px 24px; overflow: hidden; white-space: nowrap; background: #333a30; color: #fefefd; font-size: 10px; letter-spacing: .16em; }
  .fashion-ticker span::before { content: '✦'; margin-right: 55px; color: #cbcb97; }
  .fashion-collections { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding-top: 44px; }
  .fashion-collection-card { position: relative; color: inherit; text-decoration: none; }
  .fashion-collection-card__image { overflow: hidden; aspect-ratio: 1.15; border-radius: 10px; background: #ededdb; }
  .fashion-collection-card__image img, .fashion-collection-card__image svg { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .fashion-collection-card:hover img { transform: scale(1.04); }
  .fashion-collection-card > span:not(.fashion-collection-card__arrow) { position: absolute; bottom: 14px; left: 14px; right: 14px; padding: 10px 16px; border-radius: 40px; background: rgba(255,255,255,.94); font-size: 11px; letter-spacing: .08em; text-align: center; text-transform: uppercase; }
  .fashion-collection-card__arrow { position: absolute; right: 29px; bottom: 12px; font-size: 16px; }
  .fashion-products { padding: 106px 0 90px; }
  .fashion-latest-products { padding: 92px 0 72px; }
  .fashion-products { display: none; }
  .fashion-section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 36px; }
  .fashion-section-heading h2, .fashion-story h2 { margin: 0; max-width: 580px; font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: .95; letter-spacing: -.06em; font-weight: 500; }
  .fashion-text-link { display: inline-flex; align-items: center; gap: 12px; color: inherit; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .fashion-product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .fashion-product-card { color: inherit; text-decoration: none; }
  .fashion-product-card__image { position: relative; overflow: hidden; aspect-ratio: 3 / 4; border-radius: 10px; background: #ededdb; }
  .fashion-product-card__image img, .fashion-product-card__image svg { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .fashion-product-card:hover img { transform: scale(1.04); }
  .fashion-product-card__info { display: flex; justify-content: space-between; gap: 10px; padding-top: 12px; font-size: 13px; }
  .fashion-product-card__info span:last-child { color: #696b62; }
  .fashion-badge { position: absolute; top: 12px; left: 12px; padding: 6px 11px; border-radius: 40px; background: #fffdf8; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
  .fashion-empty-state { padding: 60px; border: 1px solid #cbcb97; border-radius: 10px; text-align: center; }
  .fashion-empty-state p { margin-bottom: 22px; }
  .fashion-story { display: grid; grid-template-columns: 1fr 1fr; min-height: 500px; margin-bottom: 100px; border-radius: 10px; overflow: hidden; background: #ededdb; }
  .fashion-story__panel { display: flex; flex-direction: column; align-items: start; justify-content: center; padding: clamp(35px, 7vw, 90px); }
  .fashion-story__panel > p:not(.fashion-eyebrow) { max-width: 390px; margin: 26px 0 30px; color: #555a51; line-height: 1.6; }
  .fashion-story__shape { position: relative; overflow: hidden; min-height: 400px; background: #a8a854; }
  .fashion-story__shape::before, .fashion-story__shape::after, .fashion-story__shape span { content: ''; position: absolute; border-radius: 50%; }
  .fashion-story__shape::before { width: 65%; aspect-ratio: 1; right: -10%; top: -20%; background: #b8b7a8; }
  .fashion-story__shape::after { width: 62%; aspect-ratio: 1; left: -17%; bottom: -24%; background: #cbcb97; }
  .fashion-story__shape span { width: 39%; aspect-ratio: 1; left: 34%; top: 25%; background: #ede8df; box-shadow: 35px 28px 0 #343b31; }
  @media (max-width: 800px) { .fashion-hero__stamp { top: 12%; right: 8%; width: 80px; height: 80px; font-size: 8px; } .fashion-product-grid, .fashion-collections { grid-template-columns: repeat(2, 1fr); row-gap: 34px; } .fashion-section-heading { align-items: start; flex-direction: column; } .fashion-story { grid-template-columns: 1fr; } .fashion-story__shape { min-height: 320px; } }
  @media (max-width: 520px) { .page-width, .fashion-hero__content { width: min(100% - 32px, 1180px); } .fashion-hero { min-height: 650px; } .fashion-hero__content { padding-bottom: 48px; } .fashion-hero__stamp { display: none; } .fashion-ticker { justify-content: start; gap: 24px; } .fashion-ticker span::before { margin-right: 24px; } .fashion-products { padding: 72px 0; } .fashion-collections { grid-template-columns: 1fr; padding-top: 26px; } .fashion-story { margin-bottom: 60px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Fashion home",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow", "default": "The new everyday" },
    { "type": "text", "id": "heading", "label": "Hero heading", "default": "Wear your story." },
    { "type": "textarea", "id": "text", "label": "Hero text", "default": "Thoughtful pieces for the days that become memories. Made to move with you." },
    { "type": "image_picker", "id": "slide_1_image", "label": "Carousel landscape 1" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Carousel landscape 2" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Carousel landscape 3" },
    { "type": "image_picker", "id": "slide_4_image", "label": "Carousel landscape 4" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },
    { "type": "text", "id": "button_label", "label": "Hero button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link", "label": "Hero button link" },
    { "type": "text", "id": "free_shipping_threshold", "label": "Shipping threshold", "default": "$100" },
    { "type": "collection", "id": "collection", "label": "Featured collection" },
    { "type": "collection", "id": "collection_1", "label": "Category card 1" },
    { "type": "collection", "id": "collection_2", "label": "Category card 2" },
    { "type": "collection", "id": "collection_3", "label": "Category card 3" },
    { "type": "text", "id": "collection_eyebrow", "label": "Collection eyebrow", "default": "Curated for now" },
    { "type": "text", "id": "collection_heading", "label": "Collection heading", "default": "Pieces with presence." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 2, "default": 4 },
    { "type": "text", "id": "story_eyebrow", "label": "Story eyebrow", "default": "Less, but better" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "Clothes that stay with you." },
    { "type": "textarea", "id": "story_text", "label": "Story text", "default": "We believe getting dressed should feel effortless. Our collections are considered, versatile, and designed to be lived in." },
    { "type": "url", "id": "story_link", "label": "Story link" }
  ],
  "presets": [{ "name": "Fashion home" }]
}
{% endschema %}
