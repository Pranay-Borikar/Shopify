<section class="vintage-cart vintage-cart-width">
  <div class="vintage-cart__heading"><p class="cart-eyebrow">Your edit</p><h1>Your cart</h1></div>
  {% if cart.item_count == 0 %}<div class="vintage-cart__empty"><h2>Your cart is waiting.</h2><a class="cart-button" href="{{ routes.all_products_collection_url }}">Continue shopping ↗</a></div>{% else %}
    <form action="{{ routes.cart_url }}" method="post"><div class="vintage-cart__items">{% for item in cart.items %}<article class="vintage-cart__item"><a href="{{ item.url }}"><div class="vintage-cart__image">{% if item.image %}{{ item.image | image_url: width: 400 | image_tag }}{% endif %}</div></a><div><h2>{{ item.product.title }}</h2><p>{{ item.variant.title }}</p><a class="vintage-cart__remove" href="{{ item.url_to_remove }}">Remove</a></div><div class="vintage-cart__quantity"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"><span>{{ item.final_line_price | money }}</span></div></article>{% endfor %}</div><div class="vintage-cart__summary"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong><p>Taxes and shipping calculated at checkout.</p><button class="product-add" type="submit" name="checkout">Checkout ↗</button><button class="vintage-cart__update" type="submit" name="update">Update cart</button></div></form>
  {% endif %}
</section>
{% stylesheet %}
  .vintage-cart-width { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }.vintage-cart { padding: 70px 0 110px; }.cart-eyebrow { margin: 0 0 18px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; }.vintage-cart__heading { margin-bottom: 50px; }.vintage-cart h1 { margin: 0; font-size: clamp(3rem, 7vw, 6rem); line-height: .9; letter-spacing: -.07em; }.vintage-cart__empty { padding: 80px 30px; border: 1px solid #dfe0c7; border-radius: 10px; text-align: center; }.vintage-cart__empty h2 { margin-bottom: 24px; }.cart-button { display: inline-flex; padding: 15px 22px; border-radius: 40px; background: #333a30; color: white; text-decoration: none; }.vintage-cart form { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(260px, .7fr); gap: 70px; }.vintage-cart__item { display: grid; grid-template-columns: 110px 1fr auto; align-items: center; gap: 18px; padding: 18px 0; border-top: 1px solid #dfe0c7; }.vintage-cart__image { overflow: hidden; aspect-ratio: 3 / 4; border-radius: 8px; background: #ededdb; }.vintage-cart__image img { width: 100%; height: 100%; object-fit: cover; }.vintage-cart__item h2 { margin: 0 0 8px; font-size: 15px; }.vintage-cart__item p, .vintage-cart__remove, .vintage-cart__summary p { color: #777b70; font-size: 12px; }.vintage-cart__remove { display: inline-block; margin-top: 22px; }.vintage-cart__quantity { display: grid; gap: 12px; justify-items: end; }.vintage-cart__quantity input { width: 56px; padding: 8px; border: 1px solid #bfc19d; border-radius: 40px; text-align: center; }.vintage-cart__summary { align-self: start; padding: 28px; border-radius: 10px; background: #ededdb; }.vintage-cart__summary > span { margin-right: 20px; }.vintage-cart__summary strong { float: right; }.vintage-cart__summary p { clear: both; padding: 25px 0; line-height: 1.5; }.vintage-cart__summary .product-add { margin-top: 0; }.vintage-cart__update { display: block; margin: 16px auto 0; border: 0; background: transparent; text-decoration: underline; cursor: pointer; }.vintage-cart__summary .product-add { color: white; }.vintage-cart__summary .product-add:hover { color: white; }.vintage-cart__summary .product-add + .vintage-cart__update { color: #333a30; }
  @media (max-width: 700px) { .vintage-cart-width { width: calc(100% - 32px); }.vintage-cart form { display: block; }.vintage-cart__summary { margin-top: 40px; }.vintage-cart__item { grid-template-columns: 80px 1fr; }.vintage-cart__quantity { grid-column: 2; display: flex; justify-content: space-between; align-items: center; } }
{% endstylesheet %}
{% schema %}{ "name": "Vintage cart", "settings": [] }{% endschema %}
